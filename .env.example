# ==============================================================================
# CLASSIFIEDS V2 — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. PostgreSQL / Cloud SQL Authoritative Persistence Layer
SQL_HOST="localhost"
SQL_DB_NAME="cloud_sql_development_database"
SQL_USER="postgres"
SQL_PASSWORD=""
# Optional standard PostgreSQL connection string (alternative to discrete SQL_* vars)
DATABASE_URL=""

# 2. Authentication & Session Security
# Server-side session cookie: chillyads_session
# Optional Firebase Admin project ID if Firebase ID token verification is enabled
FIREBASE_PROJECT_ID=""

# 3. Payment Gateway Configuration (Fail-Closed by Default)
# IMPORTANT: No real payment gateway is configured by default.
# While PAYMENT_GATEWAY_SECRET is empty/unset, boost orders remain PENDING and
# payment verification fails closed (HTTP 503) without activating paid features.
PAYMENT_GATEWAY_PROVIDER=""
PAYMENT_GATEWAY_SECRET=""

# 4. Payment Webhook Verification Secret (Fail-Closed by Default)
# While PAYMENT_WEBHOOK_SECRET is empty/unset, incoming webhook requests are rejected (HTTP 503).
PAYMENT_WEBHOOK_SECRET=""

# 5. Scheduled Maintenance & Cron Security
# Required Bearer secret for /api/cron/expire-boosts
CRON_SECRET=""

# 6. Platform & AI Studio Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
